PORT=3000
DATABASE_URL="file:./data/db/dev.db"

GUMROAD_STORE_URL="https://zoubire.gumroad.com"
GUMROAD_API_TOKEN=""

OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1"

COMFYUI_URL="http://127.0.0.1:8188"
COMFYUI_WORKFLOW="default"

PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/pinterest/oauth/callback"
PINTEREST_SCOPES="boards:read boards:write pins:read pins:write"
# Only for Pinterest apps created BEFORE 2025-09-25: set "true" so the OAuth
# exchange requests a continuous (60-day, indefinitely refreshable) token.
# Apps created on/after 2025-09-25 get one automatically — leave "false".
PINTEREST_CONTINUOUS_REFRESH="false"
# Safety switch for the integration test: live publishing only happens when
# this is "true" AND a valid Pinterest token is stored. Default dry-run.
PINTEREST_LIVE_PUBLISH="false"

APP_TIMEZONE="Europe/Madrid"
SCHEDULER_START_TIME="09:00"
SCHEDULER_END_TIME="21:00"
SCHEDULER_PINS_PER_DAY="5"

PUBLISHING_MODE="manual"
PINS_PER_DAY="5"
MIN_INTERVAL_MINUTES="120"

BRAND_NAME="Zoubire"
BRAND_STORE_URL="https://zoubire.gumroad.com"
BRAND_DEFAULT_CTA="Shop now on Gumroad"
BRAND_FOOTER="More practical tools on Gumroad"
