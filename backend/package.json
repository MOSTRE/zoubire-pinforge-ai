{
  "name": "pinforge-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node scripts/run-with-env.cjs prisma migrate dev --name init --schema ../prisma/schema.prisma",
    "db:deploy": "node scripts/run-with-env.cjs prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:studio": "node scripts/run-with-env.cjs prisma studio --schema ../prisma/schema.prisma",
    "sync": "tsx src/cli/sync.ts",
    "worker": "tsx src/cli/worker.ts",
    "pinterest:doctor": "tsx src/cli/doctor.ts",
    "prisma:generate": "node scripts/run-with-env.cjs prisma generate --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/multipart": "^7.7.3",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "node-cron": "^3.0.3",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
  }
}
